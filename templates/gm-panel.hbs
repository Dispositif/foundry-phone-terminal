<div class="spt-gm">
  {{!-- Status bar: network, pending messages, ongoing call --}}
  <header class="spt-gm-status {{#if down}}down{{/if}}" aria-label="{{spt "Gm.Status"}}">
    <span class="spt-pill"><i class="fas {{#if down}}fa-ban{{else}}fa-tower-cell{{/if}}"></i> {{#if down}}{{spt "Net.DownAll"}}{{else}}{{spt "Net.Ok"}}{{/if}}</span>
    {{#each jams}}<a class="spt-pill spt-jam-pill" data-action="openPhone" data-uuid="{{uuid}}" title="{{spt "Jammer.Open"}}"><i class="fas fa-tower-broadcast"></i> {{label}}</a>{{/each}}
    {{#if pending}}<span class="spt-gm-pending">{{spt "Net.Pending" n=pending}}</span>{{/if}}
    <button type="button" class="spt-gm-net" data-action="toggleNetwork">{{#if down}}{{spt "Net.Restore"}}{{else}}{{spt "Net.Cut"}}{{/if}}</button>
  </header>
  {{#if ringing}}
  <div class="spt-gm-ringing">
    <i class="fas fa-phone-volume"></i> {{spt "Gm.RingingAt" who=ringing}}
    <button type="button" data-action="hangup" title="{{spt "Call.HangUp"}}" aria-label="{{spt "Call.HangUp"}}"><i class="fas fa-phone-slash"></i></button>
  </div>
  {{/if}}

  {{!-- Tabs --}}
  <nav class="spt-tabs" role="tablist">
    <a class="spt-tab {{#if (eq tab "send")}}active{{/if}}" data-action="switchTab" data-tab="send" role="tab"><i class="fas fa-paper-plane"></i> {{spt "Gm.TabSend"}}</a>
    <a class="spt-tab {{#if (eq tab "inbox")}}active{{/if}}" data-action="switchTab" data-tab="inbox" role="tab"><i class="fas fa-inbox"></i> {{spt "Gm.TabInbox"}}{{#if inboxUnread}} <span class="spt-badge">{{inboxUnread}}</span>{{/if}}</a>
    <a class="spt-tab {{#if (eq tab "calls")}}active{{/if}}" data-action="switchTab" data-tab="calls" role="tab"><i class="fas fa-phone"></i> {{spt "Calls.Tab"}}</a>
    <a class="spt-tab {{#if (eq tab "devices")}}active{{/if}}" data-action="switchTab" data-tab="devices" role="tab"><i class="fas fa-mobile-screen"></i> {{spt "Gm.TabDevices"}} <span class="spt-count">{{deviceCount}}</span></a>
    <a class="spt-tab {{#if (eq tab "files")}}active{{/if}}" data-action="switchTab" data-tab="files" role="tab"><i class="fas fa-folder-tree"></i> {{spt "Files.Tab"}}{{#if fileCount}} <span class="spt-count">{{fileCount}}</span>{{/if}}</a>
    <a class="spt-tab {{#if (eq tab "tracking")}}active{{/if}}" data-action="switchTab" data-tab="tracking" role="tab" title="{{spt "Track.Hint"}}"><i class="fas fa-location-crosshairs"></i> {{spt "Gm.TabTracking"}}</a>
  </nav>

  <div class="spt-tab-body">
  {{#if (eq tab "send")}}
    <section class="spt-gm-send">
      <div class="form-group">
        <label>{{spt "Gm.Recipient"}}</label>
        <div class="spt-icon-select"><i class="fas fa-mobile-screen"></i>
          <select name="target" data-icon-select>
            {{#if targetPlayers.length}}<optgroup label="{{spt "Gm.PlayersDirect"}}">{{#each targetPlayers}}<option value="{{value}}" data-icon="fa-user" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>{{/if}}
            {{#if targetDevices.length}}<optgroup label="{{spt "Devices"}}">{{#each targetDevices}}<option value="{{value}}" data-icon="{{icon}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>{{/if}}
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>{{spt "Gm.Sender"}}</label>
        <input type="text" name="sender" value="{{sender}}" placeholder="{{spt "Masked"}}" list="spt-senders" autocomplete="off">
        <datalist id="spt-senders">{{#each senderOptions}}<option value="{{value}}" label="{{label}}"></option>{{/each}}</datalist>
      </div>

      {{#if messaging}}
      <div class="spt-segmented" role="radiogroup">
        <a class="{{#if (eq mode "message")}}active{{/if}}" data-action="mode" data-mode="message" role="radio"><i class="fas fa-comment-sms"></i> {{spt "Gm.ModeMessage"}}</a>
        <a class="{{#if (eq mode "call")}}active{{/if}}" data-action="mode" data-mode="call" role="radio"><i class="fas fa-phone"></i> {{spt "Gm.ModeCall"}}</a>
      </div>
      {{/if}}

      {{#if (eq mode "message")}}
      <div class="spt-drop" title="{{spt "DropHere"}}">
        {{{attChip}}}
        <textarea name="text" rows="5" placeholder="{{spt "Gm.MessagePlaceholder"}}">{{text}}</textarea>
      </div>
      <p class="spt-drop-hint"><i class="fas fa-file-import"></i> {{spt "Gm.DropJournal"}}</p>
      <div class="spt-phone-row">
        <button type="button" class="spt-icon-btn" data-action="attach" title="{{spt "AttachImage"}}" aria-label="{{spt "AttachImage"}}"><i class="fas fa-paperclip"></i></button>
        <button type="button" class="spt-icon-btn" data-action="copyLink" title="{{spt "Gm.CopyLink"}}" aria-label="{{spt "Gm.CopyLink"}}"><i class="fas fa-link"></i></button>
        {{#if canSecure}}<button type="button" class="spt-icon-btn spt-secure-link" data-action="copySecureLink" title="{{spt "Secure.CopyLink"}}" aria-label="{{spt "Secure.CopyLink"}}"><i class="fas fa-link"></i><i class="fas fa-shield-halved"></i></button>{{/if}}
        <button type="button" class="spt-primary" data-action="sms"><i class="fas fa-paper-plane"></i> {{spt "Send"}}</button>
        {{#if canSecure}}<button type="button" class="spt-primary spt-secure-btn" data-action="smsSecure" title="{{spt "Secure.BoxHint"}}"><i class="fas fa-shield-halved"></i> {{spt "Secure.Send"}}</button>{{/if}}
      </div>
      {{else}}
      <div class="spt-phone-row">
        <button type="button" class="spt-icon-btn" data-action="copyLink" title="{{spt "Gm.CopyLink"}}" aria-label="{{spt "Gm.CopyLink"}}"><i class="fas fa-link"></i></button>
        {{#if canSecure}}<button type="button" class="spt-icon-btn spt-secure-link" data-action="copySecureLink" title="{{spt "Secure.CopyLink"}}" aria-label="{{spt "Secure.CopyLink"}}"><i class="fas fa-link"></i><i class="fas fa-shield-halved"></i></button>{{/if}}
        <button type="button" class="spt-primary" data-action="ring"><i class="fas fa-phone-volume"></i> {{spt "Gm.Ring"}}</button>
        {{#if canSecure}}<button type="button" class="spt-primary spt-secure-btn" data-action="ringSecure" title="{{spt "Secure.BoxHint"}}"><i class="fas fa-shield-halved"></i> {{spt "Secure.Ring"}}</button>{{/if}}
      </div>
      {{/if}}
    </section>
  {{/if}}

  {{#if (eq tab "inbox")}}
    <section class="spt-gm-inbox">
      <nav class="spt-subtabs">
        <a class="spt-subtab {{#if (eq inboxView "npc")}}active{{/if}}" data-action="switchInbox" data-view="npc"><i class="fas fa-user-secret"></i> {{spt "Gm.InboxNpc"}}{{#if inboxUnread}} <span class="spt-badge">{{inboxUnread}}</span>{{/if}}</a>
        <a class="spt-subtab {{#if (eq inboxView "agents")}}active{{/if}}" data-action="switchInbox" data-view="agents"><i class="fas fa-user-group"></i> {{spt "Gm.InboxAgents"}}</a>
      </nav>
      {{#if inbox.length}}
      <div class="spt-gthreads">
        {{#each inbox}}
        <div class="spt-gthread {{#if unread}}unread{{/if}} {{#if agents}}agents{{/if}}" data-thread="{{id}}" data-uuid="{{uuid}}" data-key="{{key}}">
          <div class="spt-gthread-head">{{#if agents}}<i class="fas fa-user-group spt-dim" title="{{spt "Gm.BetweenAgents"}}"></i> {{/if}}<i class="fas {{icon}} spt-dim" title="{{modelLabel}}"></i> <strong>{{who}}</strong>{{#if compromised}} <i class="fas fa-triangle-exclamation spt-compromised" title="{{spt "Gm.Compromised"}}"></i>{{/if}} <i class="fas fa-arrow-right" aria-hidden="true"></i> {{#if agents}}{{#each others}}{{#unless @first}}, {{/unless}}{{#if icon}}<i class="fas {{icon}} spt-dim" title="{{modelLabel}}"></i> {{/if}}{{name}}{{/each}}{{else}}{{to}}{{/if}}{{#if canSecure}} <a data-action="toggleSecureWith" class="spt-secure-toggle {{#if secure}}on{{/if}}" title="{{#if secure}}{{spt "Secure.On"}}{{else}}{{spt "Secure.Off"}}{{/if}}"><i class="fas fa-shield-halved"></i></a>{{else if secure}} <i class="fas fa-shield-halved spt-secure" title="{{spt "Secure.Line"}}"></i>{{/if}}{{#if unknown}} <small class="spt-dim">({{spt "Directory.Unknown"}})</small>{{/if}}{{#if unread}} <span class="spt-badge">{{unread}}</span>{{/if}}</div>
          {{#if more}}<div class="spt-gthread-more">…</div>{{/if}}
          {{#each bubbles}}
          <div class="spt-bb {{dir}} {{#if pending}}pending{{/if}}">{{#if secure}}<i class="fas fa-shield-halved spt-secure spt-bb-secure" title="{{spt "Secure.Message"}}"></i>{{/if}}{{#if fwd}}<span class="spt-bb-fwd"><i class="fas fa-share"></i> {{spt "Fwd.Forwarded"}}</span>{{/if}}{{{att}}}{{#if text}}<div>{{{text}}}</div>{{/if}}</div>
          {{/each}}
          {{#unless agents}}
          <div class="spt-gthread-reply">
            <input type="text" data-draft="{{id}}" value="{{draft}}" placeholder="{{spt "Gm.ReplyAs" name=to}}" aria-label="{{spt "Gm.ReplyAs" name=to}}">
            <button type="button" data-action="sendReply" aria-label="{{spt "Send"}}" data-tooltip="{{spt "Send"}}"><i class="fas fa-paper-plane"></i></button>
            {{#if canCall}}<button type="button" data-action="callBack" aria-label="{{spt "Gm.CallBack"}}" data-tooltip="{{spt "Gm.CallBack"}}"><i class="fas fa-phone"></i></button>{{/if}}
          </div>
          {{/unless}}
        </div>
        {{/each}}
      </div>
      {{#if showMarkAll}}<a class="spt-mark-all" data-action="markAllSeen">{{spt "Gm.MarkAllSeen"}}</a>{{/if}}
      {{else}}
      <p class="spt-phone-status">{{spt "Gm.NoInbox"}}</p>
      {{/if}}
    </section>
  {{/if}}

  {{#if (eq tab "devices")}}
    <section class="spt-gm-devices">
      {{#each groups}}
      <div class="spt-dev-group">
        <header class="spt-dev-group-head">
          {{#if img}}<img src="{{img}}" alt="">{{else}}<span class="spt-dev-avatar"><i class="fas {{icon}}"></i></span>{{/if}}
          <strong>{{name}}</strong>
        </header>
        <ul class="spt-dev-list">
          {{#each devices}}
          <li class="spt-dev">
            {{#if jammer}}
            <a class="spt-dev-main" data-action="openPhone" data-uuid="{{uuid}}" title="{{spt "Jammer.Open"}}">
              <i class="fas {{icon}} {{#if jamOn}}spt-jamming{{/if}}" title="{{modelLabel}}"></i>
              <span class="spt-dev-label">{{label}}</span>
              {{#if jamOn}}<span class="spt-jam-state on">{{spt "Jammer.StateOn"}}</span>{{/if}}
              {{#if jamFailed}}<span class="spt-jam-state">{{spt "Jammer.StateFailed"}}</span>{{/if}}
            </a>
            {{else}}
            <a class="spt-dev-main" data-action="selectPhone" data-number="{{number}}" title="{{spt "Gm.PickRecipient"}}">
              <i class="fas {{icon}}" title="{{modelLabel}}"></i>
              <span class="spt-dev-label">{{label}} <small>{{number}}</small></span>
              {{#if modeIcon}}<i class="fas {{modeIcon}} spt-dim" title="{{modeLabel}}"></i>{{/if}}
              {{#if locked}}<i class="fas fa-lock spt-warn spt-dev-state" title="{{spt "Gm.Locked"}}"></i>{{/if}}
              {{#if secure}}<i class="fas fa-shield-halved spt-secure spt-dev-state" title="{{spt "Secure.Device"}}"></i>{{/if}}
              {{#if compromised}}<i class="fas fa-triangle-exclamation spt-compromised spt-dev-state" title="{{spt "Gm.Compromised"}}"></i>{{/if}}
              {{#if noSignal}}<i class="fas fa-signal spt-nosignal spt-dev-state" title="{{spt "Gm.NoSignal"}}"></i>{{/if}}
              {{#if cloned}}<i class="fas fa-clone spt-warn" title="{{spt "Gm.ClonedHint"}}"></i>{{/if}}
              {{#if unread}}<span class="spt-row-unread" title="{{unreadTitle}}"><i class="fas fa-envelope"></i> {{unread}}</span>{{/if}}
            </a>
            {{/if}}
            <span class="spt-dev-actions" aria-label="{{spt "Gm.Actions"}}">
              <a data-action="openPhone" data-uuid="{{uuid}}" title="{{spt "Gm.OpenPrepare"}}" aria-label="{{spt "Gm.OpenPrepare"}}"><i class="fas fa-pen-to-square"></i></a>
              {{#unless jammer}}
              <a data-action="toggleLock" data-uuid="{{uuid}}" class="{{#if locked}}spt-locked{{/if}}" title="{{#if locked}}{{spt "Gm.Locked"}}{{else}}{{spt "Gm.Unlocked"}}{{/if}}" aria-label="{{#if locked}}{{spt "Gm.Locked"}}{{else}}{{spt "Gm.Unlocked"}}{{/if}}"><i class="fas {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></a>
              <a data-action="toggleCompromised" data-uuid="{{uuid}}" class="{{#if compromised}}spt-compromised{{/if}}" title="{{#if compromised}}{{spt "Gm.Compromised"}}{{else}}{{spt "Gm.NotCompromised"}}{{/if}}" aria-label="{{#if compromised}}{{spt "Gm.Compromised"}}{{else}}{{spt "Gm.NotCompromised"}}{{/if}}"><i class="fas fa-triangle-exclamation"></i></a>
              {{#unless fixed}}<a data-action="toggleSignal" data-uuid="{{uuid}}" class="{{#if noSignal}}spt-nosignal{{/if}}" title="{{#if noSignal}}{{spt "Gm.NoSignal"}}{{else}}{{spt "Gm.SignalOk"}}{{/if}}" aria-label="{{#if noSignal}}{{spt "Gm.NoSignal"}}{{else}}{{spt "Gm.SignalOk"}}{{/if}}"><i class="fas fa-signal"></i></a>{{/unless}}
              <a data-action="contacts" data-uuid="{{uuid}}" title="{{spt "Contacts.Title"}}" aria-label="{{spt "Contacts.Title"}}"><i class="fas fa-address-book"></i></a>
              {{/unless}}
              {{#unless fixed}}<a data-action="give" data-uuid="{{uuid}}" title="{{spt "Gm.GiveTo"}}" aria-label="{{spt "Gm.GiveTo"}}"><i class="fas fa-hand-holding"></i></a>{{/unless}}
              <a data-action="editPhone" data-uuid="{{uuid}}" title="{{spt "Gm.Edit"}}" aria-label="{{spt "Gm.Edit"}}"><i class="fas fa-gear"></i></a>
              <a data-action="unmarkPhone" data-uuid="{{uuid}}" title="{{spt "Gm.Remove"}}" aria-label="{{spt "Gm.Remove"}}"><i class="fas fa-trash"></i></a>
            </span>
          </li>
          {{/each}}
        </ul>
      </div>
      {{else}}
      <p class="spt-phone-status">{{spt "Gm.NoDevices"}}</p>
      {{/each}}
    </section>
  {{/if}}
  {{#if (eq tab "calls")}}
    <section class="spt-gm-calls">
      {{#if calls.length}}
      {{#each calls}}
      <h4 class="spt-call-when">{{label}}</h4>
      <ul class="spt-call-list">
        {{#each rows}}
        <li class="spt-call-row {{#if answered}}answered{{/if}} {{#if live}}live{{/if}}">
          <i class="fas {{#if answered}}fa-phone{{else}}fa-phone-slash{{/if}} spt-call-icon"></i>
          <span class="spt-call-who">{{#unless fromAgent}}<i class="fas fa-user-secret spt-dim" title="{{spt "Calls.FromGm"}}"></i> {{/unless}}{{from}} <i class="fas fa-arrow-right" aria-hidden="true"></i> {{to}}{{#if compromised}} <i class="fas fa-triangle-exclamation spt-compromised" title="{{spt "Gm.Compromised"}}"></i>{{/if}}{{#if secure}} <i class="fas fa-shield-halved spt-secure" title="{{spt "Secure.Line"}}"></i>{{/if}}</span>
          {{#if live}}
          <span class="spt-call-res spt-call-live"><i class="fas fa-circle"></i> {{spt "Live.OnLine"}} {{{live}}}</span>
          {{else}}
          <span class="spt-call-res">{{result}}{{#if dur}} <span class="spt-call-dur">{{dur}}</span>{{/if}}</span>
          {{/if}}
        </li>
        {{/each}}
      </ul>
      {{/each}}
      {{else}}
      <p class="spt-phone-status">{{spt "Calls.None"}}</p>
      {{/if}}
    </section>
  {{/if}}
  {{#if (eq tab "files")}}
    <section class="spt-gm-files">
      {{#if files.hasComputers}}
      <div class="spt-segmented spt-fx-view" role="radiogroup" aria-label="{{spt "Files.GroupBy"}}">
        <a data-action="filesView" data-view="device" class="{{#if (eq files.view "device")}}active{{/if}}" role="radio"><i class="fas fa-desktop"></i> {{spt "Files.ByDevice"}}</a>
        <a data-action="filesView" data-view="journal" class="{{#if (eq files.view "journal")}}active{{/if}}" role="radio"><i class="fas fa-book"></i> {{spt "Files.ByJournal"}}</a>
      </div>
      <div class="spt-fx-bar">
        <span class="spt-fx-pick">
          {{#each files.filters}}<a data-action="filesFilter" data-filter="{{key}}" class="{{#if active}}active{{/if}}" title="{{label}}" aria-label="{{label}}">{{#if icon}}<i class="fas {{icon}}"></i>{{else}}{{label}}{{/if}} <small>{{n}}</small></a>{{/each}}
        </span>
        <input type="search" name="filesQuery" value="{{files.query}}" placeholder="{{spt "Files.Search"}}" aria-label="{{spt "Files.Search"}}" autocomplete="off">
      </div>
      {{#each files.groups}}
      <div class="spt-dev-group spt-fx-group" {{#if journal}}data-refs="{{refs}}"{{/if}}>
        <header class="spt-dev-group-head">
          {{#if img}}<img src="{{img}}" alt="">{{else}}<span class="spt-dev-avatar"><i class="fas {{icon}}"></i></span>{{/if}}
          <span class="spt-fx-title"><strong>{{name}}</strong><small>{{sub}}</small></span>
          {{#if journal}}{{#if bulk}}
          <a class="spt-fx-pill" data-action="groupState" data-state="visible" title="{{spt "Files.RevealAll"}}"><i class="fas fa-eye"></i> {{spt "Files.All"}}</a>
          <a class="spt-fx-pill" data-action="groupState" data-state="hidden" title="{{spt "Files.HideAll"}}"><i class="fas fa-eye-slash"></i> {{spt "Files.All"}}</a>
          {{/if}}{{else}}
          <a class="spt-fx-pill {{#if locked}}warn{{/if}}" data-action="toggleLock" data-uuid="{{uuid}}" title="{{#if locked}}{{spt "Gm.Locked"}}{{else}}{{spt "Gm.Unlocked"}}{{/if}}"><i class="fas {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i> {{#if locked}}{{spt "Files.DevLocked"}}{{else}}{{spt "Files.DevOpen"}}{{/if}}</a>
          <a class="spt-fx-pill {{#unless (eq inbox "on")}}warn{{/unless}}" data-action="cycleInbox" data-uuid="{{uuid}}" data-inbox="{{inbox}}" title="{{spt "Form.Inbox"}}"><i class="fas {{inboxIcon}}"></i> {{inboxLabel}}</a>
          <a class="spt-fx-open" data-action="openPhone" data-uuid="{{uuid}}" title="{{spt "Gm.OpenPrepare"}}" aria-label="{{spt "Gm.OpenPrepare"}}"><i class="fas fa-pen-to-square"></i></a>
          {{/if}}
        </header>
        <ul class="spt-fx-files">
          {{#each files}}
          <li class="spt-fx-file spt-fx-{{state}}" data-file="{{id}}" data-uuid="{{uuid}}" {{#if mail}}data-mail="1"{{/if}} data-search="{{name}} {{device}} {{who}}">
            <i class="fas {{icon}} spt-fx-ic"></i>
            <a class="spt-fx-name" data-action="previewFile" title="{{spt "Files.Open"}}">{{name}}{{#if who}} <small>{{who}}</small>{{/if}}</a>
            {{#if device}}<span class="spt-fx-on"><i class="fas {{deviceIcon}}"></i> {{device}}</span>{{/if}}
            {{#if mail}}
            <span class="spt-fx-follow spt-fx-st-{{state}}" title="{{stateTitle}}"><i class="fas {{stateIcon}}"></i></span>
            {{else}}
            <span class="spt-fx-seg" role="radiogroup">
                <a data-action="fileState" data-state="visible" class="{{#if (eq state "visible")}}on visible{{/if}}" role="radio" title="{{spt "Files.State_visible"}}" aria-label="{{spt "Files.State_visible"}}"><i class="fas fa-eye"></i></a>
                <a data-action="fileState" data-state="locked" class="{{#if (eq state "locked")}}on locked{{/if}}" role="radio" title="{{spt "Files.State_locked"}}" aria-label="{{spt "Files.State_locked"}}"><i class="fas fa-lock"></i></a>
                <a data-action="fileState" data-state="hidden" class="{{#if (eq state "hidden")}}on off{{/if}}" role="radio" title="{{spt "Files.State_hidden"}}" aria-label="{{spt "Files.State_hidden"}}"><i class="fas fa-eye-slash"></i></a>
              </span>
            {{/if}}
          </li>
          {{else}}
          <li class="spt-fx-empty">{{spt "Files.Empty"}}</li>
          {{/each}}
        </ul>
      </div>
      {{else}}
      <p class="spt-phone-status">{{spt "Files.NoMatch"}}</p>
      {{/each}}
      {{else}}
      <p class="spt-phone-status">{{spt "Files.NoComputers"}}</p>
      {{/if}}
    </section>
  {{/if}}
  {{#if (eq tab "tracking")}}
    <section class="spt-gm-tracking">
      <p class="spt-track-hint"><span class="spt-exp-tag"><i class="fas fa-flask"></i> {{spt "Track.Experimental"}}</span> {{spt "Track.Hint"}}</p>
      {{#each tracking}}
      <div class="spt-dev-group spt-track-group">
        <header class="spt-dev-group-head">
          {{#if img}}<img src="{{img}}" alt="">{{/if}}
          <strong>{{agent}}</strong>
          {{#if location}}<span class="spt-track-scene"><i class="fas fa-question"></i> {{location}}</span>{{/if}}
          <span class="spt-track-level spt-track-{{level}}">{{levelLabel}}</span>
        </header>
        {{#if lastCall}}<div class="spt-track-call" title="{{spt "Track.LastCall"}}"><i class="fas fa-phone"></i> {{lastCall}}</div>{{/if}}
        {{#if devices.length}}
        <ul class="spt-dev-list">
          {{#each devices}}
          <li class="spt-dev spt-track">
            <i class="fas {{icon}}" title="{{modelLabel}}"></i>
            <span class="spt-dev-label">{{label}}{{#if compromised}} <i class="fas fa-triangle-exclamation spt-compromised" title="{{spt "Gm.Compromised"}}"></i>{{/if}}{{#if secure}} <i class="fas fa-shield-halved spt-secure" title="{{spt "Secure.Device"}}"></i>{{/if}}</span>
            <span class="spt-track-small">{{levelLabel}}</span>
          </li>
          {{/each}}
        </ul>
        {{/if}}
      </div>
      {{else}}
      <p class="spt-phone-status">{{spt "Track.None"}}</p>
      {{/each}}
    </section>
  {{/if}}
  </div>

  {{#if (eq tab "devices")}}
  <footer class="spt-phone-row spt-gm-foot">
    <button type="button" data-action="newPhone"><i class="fas fa-plus"></i> {{spt "NewDevice"}}</button>
    <button type="button" data-action="directory"><i class="fas fa-book-open"></i> {{spt "Directory.Title"}}</button>
  </footer>
  {{/if}}
</div>
